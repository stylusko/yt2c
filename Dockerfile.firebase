FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg chromium curl ca-certificates && apt-get clean && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_FIREBASE_ONLY=1
RUN npm run build && npm prune --omit=dev
ENV NODE_ENV=production
ENV YOUMECA_BACKEND=firebase
ENV CHROMIUM_PATH=/usr/bin/chromium
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "exec node node_modules/next/dist/bin/next start -H 0.0.0.0 -p $PORT"]
